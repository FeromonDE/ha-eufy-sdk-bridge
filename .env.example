# Copy to .env and fill in. The bridge logs in ONCE with these.
EUFY_EMAIL=
EUFY_PASSWORD=
EUFY_COUNTRY=GB

# Optional
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=3000
EUFY_SESSION=./data/.eufy-session.json
GO2RTC_CONFIG=./go2rtc.yaml
BRIDGE_SELF_HOST=127.0.0.1
# EUFY_POLL_MS=600000

# Auto-off a camera's live stream after this many ms with no detection event (motion/person/…).
# Saves battery: the P2P live session (and the radio) stops when nothing is happening, even if HA
# still has the stream "open". The next detection lets it reopen. Default 300000 (5 min); 0 disables.
STREAM_IDLE_MS=300000
